# Copy to .env for local work; on the host set these as real environment vars.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Where SQLite, uploads and collected static live. One mounted volume in production.
DJANGO_DATA_DIR=data
# SQLite journal. WAL (the default) in production; the local Docker override
# sets DELETE, because WAL's -shm file fails on a Windows bind mount.
# DJANGO_SQLITE_JOURNAL_MODE=WAL
# First-visit language by country: Iran → /, Germany → /de/, elsewhere → /en/.
# Set 0 to switch it off. The country comes from a proxy header if one is named
# (Cloudflare: HTTP_CF_IPCOUNTRY), otherwise from data/geoip/country.mmdb.
DJANGO_GEO_LANGUAGE=1
DJANGO_GEO_COUNTRY_HEADER=
# Behind nginx the client address is in a header, e.g. HTTP_X_REAL_IP.
DJANGO_GEO_CLIENT_IP_HEADER=
# DJANGO_GEO_DATABASE=data/geoip/country.mmdb

# ── A new request arrives in Bale ──────────────────────────────────────────
# Leave the token or the chat id empty and the whole feature is off: the
# contact form saves exactly as it did, and nothing is sent anywhere.
#
# Setting it up, in order:
#   1. @botfather in Bale → /newbot → paste the token below.
#   2. Start a chat with your new bot and send it /id. It answers with the
#      chat id — that goes in DJANGO_BOT_CHAT_ID. (For that first answer to
#      arrive, either the webhook is already registered, or run
#      `manage.py bale poll` in another terminal.)
#   3. Put a long random string in DJANGO_BOT_WEBHOOK_SECRET. start.sh then
#      registers https://<site>/bot/<secret>/ on every boot; by hand it is
#      `manage.py bale set-webhook`.
#   4. `manage.py bale status` says whether all of that took.
#
# Telegram works the same: set DJANGO_BOT_API=https://api.telegram.org.
# Bale is the default because it is the one that answers inside Iran.
DJANGO_BOT_API=https://tapi.bale.ai
DJANGO_BOT_TOKEN=
DJANGO_BOT_CHAT_ID=
DJANGO_BOT_WEBHOOK_SECRET=
#
# Visitors can get their request's updates in the same bot, and reply or
# cancel from there (the «دریافت پاسخ‌ها در بله» button on the tracking page).
# That half needs the bot's username, without the @ — empty keeps it off.
# For Telegram, also set DJANGO_BOT_LINK_BASE=https://t.me.
DJANGO_BOT_USERNAME=
DJANGO_BOT_LINK_BASE=https://ble.ir
